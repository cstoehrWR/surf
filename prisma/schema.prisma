generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OFFICE
  INSTRUCTOR
  CUSTOMER
}

enum ProductType {
  GROUP_COURSE
  PRIVATE_COURSE
  MULTI_DAY_COURSE
  SURF_CAMP
  RENTAL
  ADDON
  VOUCHER
  PACKAGE
  ACCOMMODATION
  CAMPING
}

enum SportType {
  SURF
  KITE
  SUP
  WINDSURF
  OTHER
}

enum BookingMode {
  SESSION
  NIGHTLY
}

enum SurfLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionStatus {
  PLANNED
  CONFIRMED
  WEATHER_CHECK
  POSTPONED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PaymentMethod {
  STRIPE
  CASH
  MANUAL
  VOUCHER
  PAYMENT_LINK
}

enum ResourceStatus {
  AVAILABLE
  RESERVED
  ISSUED
  DEFECT
  MAINTENANCE
  LOST
}

enum VoucherType {
  VALUE
  PRODUCT
  DISCOUNT
}

enum FieldType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
  DATE
  TEXTAREA
}

enum CustomFieldEntity {
  PARTICIPANT
  CUSTOMER
  BOOKING
}

model Organization {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  locale    String      @default("de")
  timezone  String      @default("Europe/Berlin")
  currency  String      @default("EUR")
  tagline   String?
  sports    SportType[] @default([SURF])
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  locations      Location[]
  users          User[]
  memberships    OrganizationMembership[]
  customers      Customer[]
  products       Product[]
  instructors    Instructor[]
  resourceTypes  ResourceType[]
  resources      Resource[]
  sessions       CourseSession[]
  bookings       Booking[]
  priceRules     PriceRule[]
  customFields   CustomField[]
  waiverTemplates WaiverTemplate[]
  vouchers       Voucher[]
  discountCodes  DiscountCode[]
  emailTemplates EmailTemplate[]
  automations    AutomationRule[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  webhookEndpoints WebhookEndpoint[]
  seasons        Season[]
  lodgingUnits   LodgingUnit[]
  waitlist       WaitlistEntry[]
  site           SiteSettings?
  sitePages      SitePage[]
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  address        String?
  timezone       String   @default("Europe/Berlin")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  sessions       CourseSession[]
  resources      Resource[]
  openingHours   OpeningHours[]
  blackouts      BlackoutPeriod[]
  seasons        Season[]
  instructorLinks InstructorLocation[]
  bookings       Booking[]
  lodgingUnits   LodgingUnit[]

  @@unique([organizationId, slug])
}

model OpeningHours {
  id         String @id @default(cuid())
  locationId String
  weekday    Int
  openTime   String
  closeTime  String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekday])
}

model BlackoutPeriod {
  id         String   @id @default(cuid())
  locationId String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Season {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  startsOn       DateTime  @db.Date
  endsOn         DateTime  @db.Date
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  organizationId String?
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role      @default(CUSTOMER)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships    OrganizationMembership[]
  accounts       Account[]
  instructor     Instructor?
  auditLogs      AuditLog[]
  loginAttempts  LoginAttempt[]
}

model OrganizationMembership {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  role           Role  @default(ADMIN)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  locale         String   @default("de")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  waitlist     WaitlistEntry[]
  consents     Consent[]

  @@index([organizationId, email])
}

model Consent {
  id         String   @id @default(cuid())
  customerId String
  type       String
  accepted   Boolean
  ip         String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Instructor {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique
  firstName      String
  lastName       String
  email          String?
  phone          String?
  qualifications String[]
  level          SurfLevel @default(INTERMEDIATE)
  maxWeeklyHours Int       @default(40)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  locations    InstructorLocation[]
  productTypes InstructorProductType[]
  absences     InstructorAbsence[]
  weeklyAvail  InstructorWeeklyAvailability[]
  sessions     SessionInstructor[]
}

model InstructorLocation {
  instructorId String
  locationId   String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([instructorId, locationId])
}

model InstructorProductType {
  instructorId String
  productType  ProductType
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([instructorId, productType])
}

model InstructorAbsence {
  id           String   @id @default(cuid())
  instructorId String
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

model InstructorWeeklyAvailability {
  id           String @id @default(cuid())
  instructorId String
  weekday      Int
  startTime    String
  endTime      String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, weekday, startTime])
}

model Product {
  id                    String      @id @default(cuid())
  organizationId        String
  locationId            String
  type                  ProductType
  sportType             SportType  @default(SURF)
  bookingMode           BookingMode @default(SESSION)
  slug                  String
  name                  String
  description           String      @db.Text
  category              String
  durationMinutes       Int
  basePrice             Decimal     @db.Decimal(10, 2)
  taxRate               Decimal     @db.Decimal(5, 2) @default(19.00)
  minParticipants       Int         @default(1)
  maxParticipants       Int         @default(8)
  minAge                Int?
  maxAge                Int?
  surfLevel             SurfLevel   @default(BEGINNER)
  bookingLeadHours      Int         @default(2)
  cancellationHours     Int         @default(24)
  requiredInstructors   Int         @default(1)
  instructorRatio       Int         @default(8)
  weekdays              Int[]
  startTimes            String[]
  seasonStart           DateTime?   @db.Date
  seasonEnd             DateTime?   @db.Date
  published             Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]
  variants     ProductVariant[]
  images       ProductImage[]
  requirements ProductResourceRequirement[]
  sessions     CourseSession[]
  bookingItems BookingItem[]
  priceRules   PriceRule[]
  waiverLinks  WaiverTemplateProduct[]
  lodgingUnits LodgingUnit[]

  @@unique([organizationId, slug])
}

model LodgingUnit {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String
  productId      String
  name           String
  code           String
  capacity       Int     @default(2)
  active         Boolean @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  nights         LodgingNight[]

  @@unique([organizationId, code])
}

model LodgingNight {
  id            String   @id @default(cuid())
  unitId        String
  bookingItemId String
  night         DateTime @db.Date
  unit          LodgingUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  bookingItem   BookingItem  @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@unique([unitId, night])
  @@index([night])
}

model ProductTranslation {
  id          String @id @default(cuid())
  productId   String
  locale      String
  name        String
  description String @db.Text
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  name        String
  sku         String?
  price       Decimal @db.Decimal(10, 2)
  minAge      Int?
  maxAge      Int?
  active      Boolean @default(true)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductResourceRequirement {
  id                      String  @id @default(cuid())
  productId               String
  resourceTypeId          String
  quantityPerParticipant  Int     @default(1)
  quantityPerSession      Int     @default(0)
  required                Boolean @default(true)
  product                 Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  resourceType            ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)
}

model ResourceType {
  id             String @id @default(cuid())
  organizationId String
  key            String
  name           String
  schema         Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources      Resource[]
  requirements   ProductResourceRequirement[]

  @@unique([organizationId, key])
}

model Resource {
  id             String         @id @default(cuid())
  organizationId String
  locationId     String
  resourceTypeId String
  inventoryCode  String
  name           String
  attributes     Json?
  status         ResourceStatus @default(AVAILABLE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  resourceType ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)
  assignments  ResourceAssignment[]

  @@unique([organizationId, inventoryCode])
}

model CourseSession {
  id              String        @id @default(cuid())
  organizationId  String
  locationId      String
  productId       String
  startsAt        DateTime
  endsAt          DateTime
  maxParticipants Int
  status          SessionStatus @default(PLANNED)
  notes           String?
  weatherNote     String?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  instructors  SessionInstructor[]
  participants SessionParticipant[]
  bookingItems BookingItem[]
  waitlist     WaitlistEntry[]

  @@unique([productId, locationId, startsAt])
  @@index([organizationId, startsAt])
  @@index([locationId, startsAt])
}

model SessionInstructor {
  sessionId    String
  instructorId String
  session      CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  instructor   Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([sessionId, instructorId])
}

model SessionParticipant {
  id             String    @id @default(cuid())
  sessionId      String
  participantId  String
  bookingId      String
  checkedInAt    DateTime?
  attendance     Boolean   @default(false)
  noShow         Boolean   @default(false)
  notes          String?

  session      CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant  Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resources    ResourceAssignment[]

  @@unique([sessionId, participantId])
}

model Booking {
  id              String         @id @default(cuid())
  organizationId  String
  locationId      String
  customerId      String
  number          String         @unique
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)
  source          String         @default("online")
  accessToken     String         @unique
  currency        String         @default("EUR")
  subtotal        Decimal        @db.Decimal(10, 2)
  taxTotal        Decimal        @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  amountPaid      Decimal        @db.Decimal(10, 2) @default(0)
  notes           String?
  overrideReason  String?
  locale          String         @default("de")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        BookingItem[]
  participants Participant[]
  sessionLinks SessionParticipant[]
  payments     Payment[]
  invoices     Invoice[]
  statusHistory BookingStatusHistory[]
  waivers      WaiverSignature[]
}

model BookingItem {
  id             String  @id @default(cuid())
  bookingId      String
  productId      String
  variantId      String?
  sessionId      String?
  checkIn        DateTime? @db.Date
  checkOut       DateTime? @db.Date
  name           String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(10, 2)
  priceBreakdown Json
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  session        CourseSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  lodgingNights  LodgingNight[]
}

model Participant {
  id           String    @id @default(cuid())
  bookingId    String
  firstName    String
  lastName     String
  dateOfBirth  DateTime? @db.Date
  age          Int?
  heightCm     Int?
  weightKg     Decimal?  @db.Decimal(5, 2)
  surfLevel    SurfLevel @default(BEGINNER)
  wetsuitSize  String?
  shoeSize     String?
  canSwim      Boolean   @default(true)
  locale       String    @default("de")
  notes        String?
  customValues Json?
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sessions     SessionParticipant[]
  waivers      WaiverSignature[]
}

model BookingStatusHistory {
  id        String         @id @default(cuid())
  bookingId String
  from      BookingStatus?
  to        BookingStatus
  reason    String?
  userId    String?
  createdAt DateTime       @default(now())
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String
  provider              String
  method                PaymentMethod
  status                PaymentStatus
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("EUR")
  providerReference     String?
  refundedAmount        Decimal       @db.Decimal(10, 2) @default(0)
  metadata              Json?
  createdAt             DateTime      @default(now())
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String   @id @default(cuid())
  bookingId String
  number    String   @unique
  issuedAt  DateTime @default(now())
  total     Decimal  @db.Decimal(10, 2)
  pdfUrl    String?
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PriceRule {
  id             String   @id @default(cuid())
  organizationId String
  productId      String?
  name           String
  type           String
  priority       Int      @default(100)
  amount         Decimal? @db.Decimal(10, 2)
  percent        Decimal? @db.Decimal(5, 2)
  minParticipants Int?
  maxParticipants Int?
  weekday        Int?
  validFrom      DateTime?
  validTo        DateTime?
  active         Boolean  @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CustomField {
  id             String            @id @default(cuid())
  organizationId String
  entity         CustomFieldEntity
  key            String
  label          String
  fieldType      FieldType
  required       Boolean           @default(false)
  options        Json?
  sensitive      Boolean           @default(false)
  specialCategory Boolean          @default(false)
  sortOrder      Int               @default(0)
  active         Boolean           @default(true)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, key])
}

model WaiverTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        Int      @default(1)
  body           String   @db.Text
  minAge         Int?
  locationId     String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       WaiverTemplateProduct[]
  signatures     WaiverSignature[]
}

model WaiverTemplateProduct {
  templateId String
  productId  String
  template   WaiverTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([templateId, productId])
}

model WaiverSignature {
  id              String   @id @default(cuid())
  bookingId       String
  participantId   String
  templateId      String
  templateVersion Int
  signerName      String
  guardian        Boolean  @default(false)
  accepted        Boolean
  signatureData   String   @db.Text
  ip              String?
  signedAt        DateTime @default(now())
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  participant     Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template        WaiverTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
}

model Voucher {
  id             String      @id @default(cuid())
  organizationId String
  code           String
  type           VoucherType
  originalValue  Decimal     @db.Decimal(10, 2)
  remainingValue Decimal     @db.Decimal(10, 2)
  validFrom      DateTime?
  validTo        DateTime?
  productId      String?
  locationId     String?
  status         String      @default("active")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model DiscountCode {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  percent        Decimal? @db.Decimal(5, 2)
  amount         Decimal? @db.Decimal(10, 2)
  validFrom      DateTime?
  validTo        DateTime?
  active         Boolean  @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model WaitlistEntry {
  id             String   @id @default(cuid())
  organizationId String
  sessionId      String
  customerId     String?
  email          String
  firstName      String
  lastName       String
  participants   Int      @default(1)
  holdUntil      DateTime?
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session        CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model ResourceAssignment {
  id                   String   @id @default(cuid())
  resourceId           String
  sessionParticipantId String
  issuedAt             DateTime @default(now())
  returnedAt           DateTime?
  damageNote           String?
  resource             Resource           @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  sessionParticipant   SessionParticipant @relation(fields: [sessionParticipantId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  channel        String
  to             String
  templateKey    String
  payload        Json
  status         String   @default("queued")
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id             String @id @default(cuid())
  organizationId String
  key            String
  locale         String @default("de")
  subject        String
  body           String @db.Text
  active         Boolean @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, locale])
}

model AutomationRule {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  trigger        String
  offsetHours    Int
  action         String
  active         Boolean @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ip             String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[]
  active         Boolean  @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String
  event      String
  payload    Json
  signature  String
  status     String   @default("pending")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

/// Tenant website (CMS): branding + pages + content blocks
model SiteSettings {
  id               String  @id @default(cuid())
  organizationId   String  @unique
  published        Boolean  @default(true)
  primaryColor     String  @default("#0f766e")
  accentColor      String  @default("#fbbf24")
  logoUrl          String?
  heroImageUrl     String?
  contactEmail     String?
  contactPhone     String?
  address          String?
  socialInstagram  String?
  socialFacebook   String?
  footerText       String?
  showBookingCta   Boolean  @default(true)
  customDomain     String? @unique
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SitePage {
  id             String  @id @default(cuid())
  organizationId String
  slug           String
  title          String
  navLabel       String?
  sortOrder      Int      @default(0)
  published      Boolean  @default(true)
  showInNav      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blocks         SiteBlock[]

  @@unique([organizationId, slug])
}

model SiteBlock {
  id        String @id @default(cuid())
  pageId    String
  type      String
  sortOrder Int    @default(0)
  content   Json
  page      SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
}
