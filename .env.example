# --- App ---
NODE_ENV=production
APP_URL=https://app.example.com
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_URL=https://app.example.com
NEXT_PUBLIC_ROOT_DOMAIN=example.com

# --- Database (Compose prod injects DATABASE_URL; local uses this) ---
POSTGRES_USER=surf
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=surf
DATABASE_URL=postgresql://surf:replace-me@localhost:5432/surf?schema=public

# --- Redis / Jobs ---
REDIS_URL=redis://localhost:6379
CRON_SECRET=replace-with-cron-secret

# --- Payments (Stripe) ---
# Leave empty to use the local mock payment provider.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_CURRENCY=eur

# --- Email (production: resend) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Surf School <noreply@example.com>

# --- Object storage (optional, S3 compatible) ---
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=surf-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Security ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PUBLIC_PER_MINUTE=60

# --- Runtime ---
DEMO_MODE=false
DEFAULT_LOCALE=de
TZ=Europe/Berlin
APP_PORT=3000
