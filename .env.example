# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://surf:surf@localhost:5432/surf?schema=public

# --- Redis / Jobs ---
REDIS_URL=redis://localhost:6379

# --- Payments (Stripe) ---
# Leave empty to use the local mock payment provider.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_CURRENCY=eur

# --- Email ---
# console | resend | smtp
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=North Sea Surf School <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Object storage (S3 compatible) ---
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=surf-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Security ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PUBLIC_PER_MINUTE=60

# --- Demo ---
DEMO_MODE=true
DEFAULT_LOCALE=de
TZ=Europe/Berlin
